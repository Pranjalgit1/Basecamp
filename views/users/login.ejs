<% layout("layouts/boilerplate.ejs") %>

<div class="signup-wrapper">
    <div class="signup-card">
        <div class="signup-header">
            <i class="fa-solid fa-house signup-logo"></i>
            <h2 class="signup-title">Welcome Back</h2>
            <p class="signup-subtitle">Log in to continue your journey on Basecamp</p>
        </div>

        <form method="POST" action="/users/login" class="signup-form needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <div class="input-icon-wrap">
                    <i class="fa-solid fa-user input-icon"></i>
                    <input type="text" name="username" id="username" placeholder="Enter your username" class="form-control signup-input" required autofocus>
                </div>
                <div class="invalid-feedback">Please enter your username.</div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <div class="input-icon-wrap">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input type="password" name="password" id="password" placeholder="Enter your password" class="form-control signup-input" required>
                </div>
                <div class="invalid-feedback">Please enter your password.</div>
            </div>

            <button type="submit" class="btn signup-btn">Log In</button>
        </form>

        <div class="signup-footer">
            <p>Don't have an account? <a href="/users/signup" class="signup-link">Sign up</a></p>
        </div>
    </div>
</div>
