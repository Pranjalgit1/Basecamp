<% layout("layouts/boilerplate.ejs") %>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3 class="mb-3"><%= listing.title %></h3>
        
        <div class="card mb-3" style="border: none;">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 40vh; object-fit: cover; border-radius: 1rem;">
            
            <div class="card-body px-0 mt-3">
                <p class="card-text">
                    <%= listing.description %> <br><br>
                    <strong>&#8377 <%= listing.price.toLocaleString("en-IN") %></strong> / night <br>
                    <%= listing.location %>, <%= listing.country %>
                </p>
            </div>
        </div>

        <div class="d-flex mb-5">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark me-3 px-4 btn-lg">Edit</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-danger px-4 btn-lg">Delete</button>
            </form>
        </div>

        <div>
            <hr>
            <h4> Leave a review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                </div>
                <div class="mb-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please submit some comments for review.</div>
                </div>
                <button class="btn btn-outline-success mt-3 mb-3 btn-lg">Submit</button>
            </form>
            <hr/>
            <p style="font-size : 1.5rem; font-weight: 500">All Reviews</p> 
            <div class="row">
                <% for(review of listing.reviews) { %>
                    <div class="card col-5 ms-3 mb-3">
                        <div class="card-body mt-2">
                            <h5 class="card-title">@jane_doe</h5>
                            <p class="card-text"><%= review.comment %></p>
                            <p class="card-text"><b>Rating:</b> <%= review.rating %> stars</p>
                            <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                <button class="btn btn-sm btn-danger">Delete Review</button>
                            </form>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
