<% layout("layouts/boilerplate.ejs") %>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3 class="mb-3"><%= listing.title %></h3>
        
        <div class="card mb-3" style="border: none;">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 40vh; object-fit: cover; border-radius: 1rem;">
            
            <div class="card-body px-0 mt-3">
                <p class="card-text">
                    <p class="mb-2 text-muted">
                        <i>Owned by <%= listing.owner.username %></i>
                        <span class="ms-4 d-inline-block align-middle">
                            <% if(listing.rating > 0) { %>
                                <p class="starability-result m-0" data-rating="<%= listing.rating %>" style="font-size: 0.6rem;">
                                    Rated: <%= listing.rating %> stars
                                </p>
                            <% } else { %>
                                <i>No ratings yet</i>
                            <% } %>
                        </span>
                    </p>
                    <%= listing.description %> <br><br>
                    <strong>$ <%= listing.price.toLocaleString("en-IN") %></strong> / night <br>
                    <%= listing.location %>, <%= listing.country %>
                </p>
            </div>
        </div>

        <!-- Where you'll be - Map Section -->
        <div class="mb-4">
            <h4 style="font-weight: 600; margin-bottom: 0.25rem;">Where you'll be</h4>
            <p class="text-muted mb-3"><%= listing.location %>, <%= listing.country %></p>
            <div id="map" style="height: 350px; border-radius: 1rem; z-index: 1;"
                 data-lat="<%= listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates[1] : 0 %>"
                 data-lng="<%= listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates[0] : 0 %>"
                 data-title="<%= listing.title %>"
                 data-location="<%= listing.location %>"
                 data-country="<%= listing.country %>">
            </div>
        </div>

        <script>
            window.addEventListener('load', function() {
                const mapElement = document.getElementById('map');
                const lat = parseFloat(mapElement.getAttribute('data-lat'));
                const lng = parseFloat(mapElement.getAttribute('data-lng'));
                const title = mapElement.getAttribute('data-title');
                const location = mapElement.getAttribute('data-location');
                const country = mapElement.getAttribute('data-country');
                
                const map = L.map('map').setView([lat, lng], 13);
                
                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
                }).addTo(map);
                
                const marker = L.marker([lat, lng]).addTo(map);
                marker.bindPopup("<b>" + title + "</b><br>" + location + ", " + country).openPopup();
            });
        </script>

        <% if (currUser && (currUser._id.equals(listing.owner._id) || currUser.username === "pranjal")) { %>
            <div class="d-flex mb-5">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark me-3 px-4 btn-lg">Edit</a>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-danger px-4 btn-lg">Delete</button>
                </form>
            </div>
        <% } %>

        <div>
            <hr>
            <h4> Leave a review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <fieldset class="starability-basic">
                        <legend>Rating:</legend>
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                <div class="mb-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please submit some comments for review.</div>
                </div>
                <button class="btn btn-outline-success mt-3 mb-3 btn-lg">Submit</button>
            </form>
            <hr/>
            <p style="font-size : 1.5rem; font-weight: 500">All Reviews</p> 
            <div class="row">
                <% for(review of listing.reviews) { %>
                    <div class="card col-5 ms-3 mb-3">
                        <div class="card-body mt-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title mb-0">@<%= review.author ? review.author.username : 'anonymous' %></h5>
                                <div class="text-end text-muted" style="font-size: 0.9rem;">
                                    <div><%= new Date(review.createdAt).toLocaleDateString('en-IN') %></div>
                                    <div style="font-size: 0.75rem;"><%= new Date(review.createdAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></div>
                                </div>
                            </div>
                            <p class="card-text mt-2"><%= review.comment %></p>
                            <p class="starability-result card-text mb-1" data-rating="<%= review.rating %>">
                                Rated: <%= review.rating %> stars
                            </p>
                            <% if (currUser && (currUser.username === 'pranjal' || (review.author && currUser._id.equals(review.author._id)))) { %>
                                <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                    <button class="btn btn-sm btn-danger mt-4">Delete Review</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
