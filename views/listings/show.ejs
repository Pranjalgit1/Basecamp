<% layout("layouts/boilerplate.ejs") %>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3 class="mb-3"><%= listing.title %></h3>
        
        <div class="card mb-3" style="border: none;">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 40vh; object-fit: cover; border-radius: 1rem;">
            
            <div class="card-body px-0 mt-3">
                <p class="card-text">
                    <%= listing.description %> <br><br>
                    <strong>&#8377 <%= listing.price.toLocaleString("en-IN") %></strong> / night <br>
                    <%= listing.location %>, <%= listing.country %>
                </p>
            </div>
        </div>

        <div class="d-flex mb-5">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark me-3 px-4">Edit</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-danger px-4">Delete</button>
            </form>
        </div>
    </div>
</div>
