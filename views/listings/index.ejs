<% layout("layouts/boilerplate.ejs") %>

<style>
    #filters{
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        border-bottom: 1px solid #ebebeb;
        padding-bottom: 0.5rem;
    }

    .filter{
        margin-left: 2rem;
        margin-top: 1.5rem;
        opacity: 0.6;
        text-align: center;
        padding: 0.3rem 0.5rem;
        text-decoration: none;
        color: inherit;
        border-bottom: 2px solid transparent;
        transition: all 0.2s ease;
    }
    .filter:hover{
        opacity: 1;
        cursor: pointer;
        color: inherit;
    }
    .filter.active{
        opacity: 1;
        border-bottom: 2px solid #222;
    }

    .filter p{
        font-size: 0.8rem;
        margin-top: 0.2rem;
        margin-bottom: 0;
    }

    .tax-toggle{
        margin-left: 2rem;
        margin-top: 1.5rem;
        text-align: center;
        padding: 0.3rem 0.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .tax-toggle .form-check-input{
        width: 2.5rem;
        height: 1.25rem;
        cursor: pointer;
    }
    .tax-toggle p{
        font-size: 0.8rem;
        margin-top: 0.2rem;
        margin-bottom: 0;
    }
    .tax-info{
        font-size: 0.7rem;
        color: #717171;
    }
</style>

<div id="filters">
    <a href="/listings" class="filter <%= activeCategory === '' ? 'active' : '' %>">
        <div><i class="fa-solid fa-border-all"></i></div>
        <p>All</p>
    </a>
    <a href="/listings?category=trending" class="filter <%= activeCategory === 'trending' ? 'active' : '' %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </a>
    <a href="/listings?category=rooms" class="filter <%= activeCategory === 'rooms' ? 'active' : '' %>">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </a>
    <a href="/listings?category=iconic cities" class="filter <%= activeCategory === 'iconic cities' ? 'active' : '' %>">
        <div><i class="fa-solid fa-city"></i></div>
        <p>Iconic Cities</p>
    </a>
    <a href="/listings?category=mountain" class="filter <%= activeCategory === 'mountain' ? 'active' : '' %>">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </a>
    <a href="/listings?category=castle" class="filter <%= activeCategory === 'castle' ? 'active' : '' %>">
        <div><i class="fa-solid fa-chess-king"></i></div>
        <p>Castles</p>
    </a>
    <a href="/listings?category=swimming pool" class="filter <%= activeCategory === 'swimming pool' ? 'active' : '' %>">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Swimming Pools</p>
    </a>
    <a href="/listings?category=camping" class="filter <%= activeCategory === 'camping' ? 'active' : '' %>">
        <div><i class="fa-solid fa-tent"></i></div>
        <p>Camping</p>
    </a>
    <a href="/listings?category=farm" class="filter <%= activeCategory === 'farm' ? 'active' : '' %>">
        <div><i class="fa-solid fa-kiwi-bird"></i></div>
        <p>Farms</p>
    </a>
    <a href="/listings?category=beach" class="filter <%= activeCategory === 'beach' ? 'active' : '' %>">
        <div><i class="fa-solid fa-umbrella-beach"></i></div>
        <p>Beach</p>
    </a>
    <a href="/listings?category=city" class="filter <%= activeCategory === 'city' ? 'active' : '' %>">
        <div><i class="fa-solid fa-building"></i></div>
        <p>City</p>
    </a>
    <div class="tax-toggle">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="taxToggle">
        </div>
        <p>Show Taxes</p>
    </div>
    
</div>

<% if(listings.length === 0) { %>
    <div class="text-center mt-5 mb-5">
        <h4 class="text-muted">No listings found for your search or filter.</h4>
        <a href="/listings" class="btn btn-dark mt-3">Clear Filters</a>
    </div>
<% } %>

<div class="row row-cols-md-2 row-cols-lg-3 row-cols-sm-1 mt-4">
    <% for(listing of listings) { %>
        <div class="col mb-4">
            <a href="/listings/<%= listing._id %>" class="listing-link" style="text-decoration: none; color: inherit;">
                <div class="card">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem; object-fit: cover;">
                    <div class="card-img-overlay">
                        <span class="stars-overlay">
                            <% for(let i=0; i<listing.rating; i++) { %>⭐<% } %>
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="card-text">
                            <strong><%= listing.title %></strong> <br>
                            <%= listing.description %> <br>
                            <span class="listing-price" data-price="<%= listing.price %>">$<%= listing.price.toLocaleString("en-IN") %></span> / night
                            <span class="tax-info" style="display:none;"> &nbsp;incl. taxes</span><br>
                            <%= listing.location %>, <%= listing.country %>
                        </p>
                    </div>
                </div>
            </a>
        </div>
    <% } %>
</div>

<script>
    document.getElementById('taxToggle').addEventListener('change', function() {
        const prices = document.querySelectorAll('.listing-price');
        const taxLabels = document.querySelectorAll('.tax-info');
        const isChecked = this.checked;

        prices.forEach(function(el) {
            const base = parseFloat(el.getAttribute('data-price'));
            if (isChecked) {
                const withTax = Math.round(base * 1.3);
                el.textContent = '$' + withTax.toLocaleString('en-IN');
            } else {
                el.textContent = '$' + base.toLocaleString('en-IN');
            }
        });

        taxLabels.forEach(function(el) {
            el.style.display = isChecked ? 'inline' : 'none';
        });
    });
</script>
