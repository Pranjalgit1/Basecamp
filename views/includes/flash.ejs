<% if(success && success.length) { %>
    <div class="flash-toast flash-success" id="flash-success">
        <div class="flash-icon">&#10004;</div>
        <div class="flash-msg"><%= success %></div>
        <button class="flash-close" onclick="this.parentElement.classList.add('flash-hide')">&times;</button>
    </div>
<% } %>

<% if(error && error.length) { %>
    <div class="flash-toast flash-error" id="flash-error">
        <div class="flash-icon">&#10008;</div>
        <div class="flash-msg"><%= error %></div>
        <button class="flash-close" onclick="this.parentElement.classList.add('flash-hide')">&times;</button>
    </div>
<% } %>

<script>
    // Auto-dismiss flash messages after 3 seconds
    setTimeout(() => {
        document.querySelectorAll('.flash-toast').forEach(el => {
            el.classList.add('flash-hide');
            // Remove from DOM after animation completes
            setTimeout(() => el.remove(), 500);
        });
    }, 3000);
</script>
